{
  "name": "@uzh-bf/design-system",
  "version": "5.0.0-alpha.5",
  "description": "React component library for University of Zurich web applications: shadcn/Radix-based primitives with UZH-aligned composites and a neutral/uzh dual theme.",
  "homepage": "https://github.com/uzh-bf/design-system#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uzh-bf/design-system.git",
    "directory": "packages/design-system"
  },
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js"
    },
    "./react-hook-form": {
      "types": "./dist/react-hook-form.d.ts",
      "import": "./dist/react-hook-form.js"
    },
    "./css": "./dist/design-system.css",
    "./preflight.css": "./dist/preflight.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-aspect-ratio": "1.2.0",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-direction": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-hover-card": "1.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-menubar": "1.2.1",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "next-themes": "0.4.6",
    "react-colorful": "5.8.1",
    "react-countdown": "2.3.6",
    "react-day-picker": "9.14.0",
    "react-resizable-panels": "3.0.6",
    "sonner": "1.7.4",
    "vaul": "1.1.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/compat": "1.4.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@ladle/react": "5.1.1",
    "@playwright/test": "1.61.0",
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react-swc": "3.10.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "magic-string": "0.30.21",
    "npm-run-all": "4.1.5",
    "prettier": "3.6.2",
    "prettier-plugin-organize-imports": "4.1.0",
    "prettier-plugin-tailwindcss": "0.6.13",
    "react-hook-form": "7.90.0",
    "react-is": "19.1.0",
    "recharts": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vite-plugin-dts": "4.5.4",
    "yup": "1.7.1"
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@tailwindcss/postcss": "^4.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "formik": "^2.4.6",
    "lucide-react": "^0.522.0",
    "postcss": "^8.4.41",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.59.0",
    "recharts": ">=3.8.0 <4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.4"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  },
  "scripts": {
    "build": "run-s build:tsc build:vite build:copy",
    "build:copy": "tsx src/copy.ts",
    "build:ladle": "LADLE=true ladle build",
    "build:tsc": "tsc -b",
    "build:vite": "vite build",
    "dev": "ladle serve",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "LADLE=true ladle preview",
    "test": "pnpm build:ladle && PWTEST_SKIP_BUILD=1 playwright test",
    "test:smoke": "pnpm build:ladle && PWTEST_SKIP_BUILD=1 playwright test tests/smoke",
    "test:a11y": "pnpm build:ladle && PWTEST_SKIP_BUILD=1 playwright test tests/a11y",
    "test:fast": "PWTEST_SKIP_BUILD=1 playwright test",
    "test:install": "playwright install --with-deps chromium",
    "test:visual": "bash scripts/visual-regression.sh",
    "test:visual:generate": "bash scripts/visual-regression.sh --generate",
    "test:theme-contract": "node tests/theme-contract/verify-packed-css.mjs",
    "test:a11y:protocol": "tsx tests/a11y/assert-inventory-artifacts.ts",
    "check": "run-s check:ts check:types",
    "check:ts": "tsc --noEmit",
    "check:types": "tsc -p tsconfig.types.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "type": "module",
  "typesVersions": {
    "*": {
      "react-hook-form": [
        "dist/react-hook-form.d.ts"
      ],
      "primitives": [
        "dist/primitives.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  }
}
