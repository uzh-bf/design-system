{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "test \"$(npx --yes pnpm@12.12.1 --version)\" = 12.12.1 && npx --yes pnpm@12.12.1 install --frozen-lockfile",
  "buildCommand": "LADLE=true npx --yes pnpm@12.12.1 --dir packages/design-system exec ladle build --base=/",
  "outputDirectory": "packages/design-system/build"
}
